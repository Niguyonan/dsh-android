<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted for 127.0.0.1 and nothing else.

  The harness is served over plain HTTP on loopback (upstream binds
  http://127.0.0.1, and its own auth is a signed cookie, not TLS). Leaving
  usesCleartextTraffic on for everything would also allow a page inside the
  WebView to fetch http:// anywhere — through a redirect, or through a link the
  agent printed. This file is the difference between "this app talks plain HTTP
  to itself" and "this app talks plain HTTP".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
