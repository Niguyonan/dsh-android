#!/system/bin/sh
# dshd — DeepSeek Harness supervisor for rooted Android.
#
# Owns, for the glibc rootfs at $DSH_ROOTFS:
#   * the bind mounts the chroot needs (/proc, /dev incl. /dev/pts, workspace, state)
#   * the guard token and the confinement posture
#   * the harness process (`dsh web --no-open --port <port>`) and the §7 token guard
#   * start/stop/restart/status, crash restart with backoff, log rotation,
#     stale-PID cleanup
#
# POSIX sh on purpose: this runs as a root shell on Android — Magisk's `mksh`,
# KernelSU's BusyBox `ash` with Standalone Mode (which is what KernelSU runs
# boot scripts in), or a plain `sh -c` from the APK — where bashisms like [[ ]],
# arrays, and `wait -n` are not available. Nothing here may assume which root
# solution granted uid 0: `dshd root` reports what it found, and docs/
# root-solutions.md records how the three differ. Run with `sh -n bin/dshd` to
# syntax-check, and see tests/run.sh for the host-side lifecycle tests.
#
# Path model — the one thing to get right:
#   The harness lives *inside* a chroot, so it cannot see /data/local/dsh.
#   state/ and workspace/ are bind-mounted to /state and /workspace in there.
#   Any absolute path handed to a child is therefore written in its own view
#   ("in-rootfs"), and translated by in_rootfs_path() for the two host-side
#   escape hatches: DSHD_NO_CHROOT=1 (development) and DSHD_DRY_RUN=1 (tests).
#
# Exit codes: 0 ok · 1 usage/config error · 2 not root · 3 not running ·
#             4 start timed out · 5 a setup step failed

set -u

# Everything dshd creates is secret-bearing: $DSH_LOG/harness.log holds the
# harness's launch token (it prints its own authenticated URL), $DSH_STATE holds
# the guard token and the harness's signing key, and /data/local is traversable
# by other apps on Android. A default umask of 022 would make those files
# world-readable, which hands the whole §7 control to any co-resident app that
# can guess a path — the token in the log is as good as the session it mints.
# Set before the first mkdir, and inherited by every child that creates a file.
umask 077

DSHD_VERSION=1
# Where the supervisor re-executes itself from. Defaults to $0 (the on-device
# case); tests/run.sh points it at a shim, because this file's shebang is
# Android's /system/bin/sh and a host cannot exec it directly.
: "${DSHD_SELF:=$0}"

# ---------------------------------------------------------------------------
# Defaults (overridable by the environment, then by $DSH_ETC/dshd.conf)
# ---------------------------------------------------------------------------

: "${DSH_BASE:=/data/local/dsh}"
: "${DSH_ROOTFS:=$DSH_BASE/rootfs}"
: "${DSH_STATE:=$DSH_BASE/state}"
: "${DSH_WORKSPACE:=$DSH_BASE/workspace}"
: "${DSH_ETC:=$DSH_BASE/etc}"
: "${DSH_LOG:=$DSH_BASE/log}"
: "${DSH_RUN:=$DSH_BASE/run}"

# Paths as seen from inside the chroot.
: "${DSH_STATE_IN:=/state}"
: "${DSH_WORKSPACE_IN:=/workspace}"

: "${DSH_HARNESS_PORT:=3080}"
: "${DSH_GUARD_PORT:=3081}"
: "${DSH_HARNESS_BIN:=/usr/local/bin/dsh}"
: "${DSH_NODE:=/usr/local/bin/node}"
: "${DSH_GUARD_SCRIPT:=/opt/dsh-android/guard.mjs}"

: "${DSH_LOG_MAX_BYTES:=5242880}"   # 5 MiB per log before rotation
: "${DSH_LOG_KEEP:=5}"              # rotated generations to keep
: "${DSH_POLL_INTERVAL:=2}"         # supervisor child-liveness poll (seconds)
: "${DSH_START_TIMEOUT:=90}"        # readiness wait after start (seconds)
: "${DSH_STOP_TIMEOUT:=15}"         # grace before SIGKILL (seconds)
: "${DSH_LAUNCH_TIMEOUT:=30}"       # wait for the harness's printed launch token
: "${DSH_BACKOFF_MIN:=1}"
: "${DSH_BACKOFF_MAX:=60}"
: "${DSH_BACKOFF_RESET:=300}"       # uptime that forgives the backoff ladder

: "${DSHD_NO_CHROOT:=0}"            # 1 = run children without chroot
: "${DSHD_DRY_RUN:=0}"              # 1 = log mutating commands instead of running
: "${DSH_FIREWALL:=off}"            # auto|on|off — see tools/firewall.sh
: "${DSH_APP_UID:=}"                # owning app UID for the firewall rule
: "${DSH_MOUNT_SYS:=0}"             # 1 = also bind /sys (not required by the plan)

# Posture default is the plan's baseline; Phase 3 may pin the fallback instead.
: "${DSH_PERMISSION_MODE:=}"

CONF="$DSH_ETC/dshd.conf"
if [ -f "$CONF" ]; then
  # shellcheck disable=SC1090  # operator-provided overrides
  . "$CONF"
fi

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

log() {
  printf '%s dshd[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$$" "$*"
}

die() {
  log "ERROR: $*" >&2
  exit 1
}

# Print a mutating command or run it, depending on DSHD_DRY_RUN.
run() {
  if [ "$DSHD_DRY_RUN" = 1 ]; then
    log "dry-run: $*"
    return 0
  fi
  "$@"
}

# Print a mutating command or run it, keeping stdout/stderr.
run_show() {
  if [ "$DSHD_DRY_RUN" = 1 ]; then
    log "dry-run: $*"
    return 0
  fi
  "$@"
}

# The path to *hand a child*, given an in-rootfs absolute path. With a real
# chroot the child sees it as written; in dev mode the rootfs directory stands
# in for /.
in_rootfs_path() {
  if [ "$DSHD_NO_CHROOT" = 1 ]; then
    printf '%s%s\n' "$DSH_ROOTFS" "$1"
  else
    printf '%s\n' "$1"
  fi
}

# The path for *dshd itself to look at*, given an in-rootfs absolute path.
# These are not interchangeable, and mixing them up is invisible in dev mode
# because in_rootfs_path() happens to prefix the rootfs there too: inside a real
# chroot an in-rootfs path is not host-readable, so a host-side -f/-x test must
# always prefix. Both spellings below were wrong in one mode or the other, and
# the wrong one on a device is fatal — start_guard() told the guard to read a
# token at /data/local/dsh/state/... inside a tree where that cannot exist.
host_path() { printf '%s%s\n' "$DSH_ROOTFS" "$1"; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

file_size() {
  # Busybox/macOS stat are not compatible; wc -c reads the file portably.
  wc -c <"$1" 2>/dev/null | tr -d ' '
}

now_seconds() { date '+%s'; }

pid_alive() {
  [ -n "$1" ] || return 1
  kill -0 "$1" 2>/dev/null || return 1
  # A zombie still answers kill -0, so a crashed child would look alive and
  # would never be restarted. Check the state field in /proc/<pid>/stat. Field 2
  # (comm) can contain spaces and parentheses, so cut at the first ')' rather
  # than field-splitting.
  if [ -r "/proc/$1/stat" ]; then
    state=$(sed 's/^[^)]*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f1)
    [ "$state" = Z ] && return 1
  fi
  return 0
}

# Reap a finished child so the supervisor does not accumulate zombies.
reap() {
  [ -n "$1" ] || return 0
  wait "$1" 2>/dev/null || true
}

# True when $1 is alive and (where /proc is available) looks like our process.
pid_is_ours() {
  pid=$1
  pattern=$2
  pid_alive "$pid" || return 1
  # Android has /proc; the host test bed does not. Without it we can only
  # prove liveness, which is what the stale-PID sweep is allowed to act on.
  [ -r "/proc/$pid/cmdline" ] || return 0
  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q "$pattern"
}

read_pid_file() {
  [ -f "$1" ] || return 1
  pid=$(tr -dc '0-9' <"$1" 2>/dev/null)
  [ -n "$pid" ] || return 1
  printf '%s\n' "$pid"
}

# Remove a PID file whose process is gone. Returns 0 when a stale file was
# cleared, which is the difference between "was" and "is" in `status`.
sweep_stale_pid() {
  file=$1
  pattern=$2
  label=$3
  [ -f "$file" ] || return 1
  pid=$(read_pid_file "$file") || { run rm -f "$file"; return 0; }
  if pid_is_ours "$pid" "$pattern"; then
    return 1
  fi
  log "stale pid file $file (pid $pid, $label) — clearing"
  run rm -f "$file"
  return 0
}

# Is $1 a mountpoint? /proc/mounts is authoritative and available on Android.
is_mounted() {
  [ -r /proc/mounts ] || return 1
  awk -v t="$1" '$2 == t { found = 1 } END { exit(found ? 0 : 1) }' /proc/mounts
}

# Is anything listening on loopback TCP port $1?
# /proc/net/tcp is the dependency-free path (Android); nc is the host fallback.
port_listening() {
  port=$1
  hex=$(printf '%04X' "$port")
  for table in /proc/net/tcp /proc/net/tcp6; do
    [ -r "$table" ] || continue
    if awk -v p=":$hex" '$2 ~ p"$" && $4 == "0A" { found = 1 } END { exit(found ? 0 : 1) }' "$table"; then
      return 0
    fi
  done
  if [ -r /proc/net/tcp ]; then
    return 1
  fi
  if command_exists nc; then
    nc -z 127.0.0.1 "$port" >/dev/null 2>&1 && return 0
    return 1
  fi
  return 2
}

require_root() {
  [ "$DSHD_DRY_RUN" = 1 ] && return 0
  # Exit 2 specifically: the APK's health check distinguishes "not root" from
  # every other failure, so this cannot go through die()'s generic 1.
  [ "$(id -u)" = 0 ] || {
    log "ERROR: must run as root (chroot and bind mounts need it)" >&2
    exit 2
  }
}

ensure_dirs() {
  for d in "$DSH_BASE" "$DSH_STATE" "$DSH_WORKSPACE" "$DSH_ETC" "$DSH_LOG" "$DSH_RUN"; do
    [ -d "$d" ] || run mkdir -p "$d"
  done
}

# ---------------------------------------------------------------------------
# Posture (§5 Phase 3 / D3)
# ---------------------------------------------------------------------------

# Resolution order: $DSH_PERMISSION_MODE env, then state/posture.conf, then the
# plan baseline. A posture file written by tools/confinement-check.sh wins over
# the baseline so the mode cannot drift per session.
permission_mode() {
  if [ -n "$DSH_PERMISSION_MODE" ]; then
    printf '%s\n' "$DSH_PERMISSION_MODE"
    return 0
  fi
  posture="$DSH_STATE/posture.conf"
  if [ -f "$posture" ]; then
    mode=$(sed -n 's/^permission_mode=//p' "$posture" | head -n 1)
    if [ -n "$mode" ]; then
      printf '%s\n' "$mode"
      return 0
    fi
  fi
  printf '%s\n' workspace-write
}

confinement_status() {
  posture="$DSH_STATE/posture.conf"
  [ -f "$posture" ] || { printf '%s\n' "unresolved (run tools/confinement-check.sh)"; return 0; }
  sed -n 's/^confinement=//p' "$posture" | head -n 1
}

# ---------------------------------------------------------------------------
# Token (§7)
# ---------------------------------------------------------------------------

token_path() { printf '%s\n' "$DSH_STATE/guard.token"; }

# The same file as the *child* must name it. Inside the chroot the bind mount
# puts $DSH_STATE at $DSH_STATE_IN, so handing the guard the host path would
# point it at /data/local/dsh/state/... inside a tree where that directory does
# not exist. The host tests could not see this: with DSHD_NO_CHROOT=1,
# in_rootfs_path() *prefixes* the rootfs, so both spellings resolve through the
# dev-mode symlink. On a device the difference is the whole control — a guard
# that cannot read its token exits, and the supervisor restarts the pair
# forever. tests/dshd.test.sh now runs a chroot-argv case for this.
guard_token_path_in() { printf '%s\n' "$DSH_STATE_IN/guard.token"; }
harness_token_path() { printf '%s\n' "$DSH_STATE/harness.token"; }
harness_token_path_in() { printf '%s\n' "$DSH_STATE_IN/harness.token"; }

ensure_token() {
  token_file=$(token_path)
  if [ -s "$token_file" ]; then
    return 0
  fi
  if [ "$DSHD_DRY_RUN" = 1 ]; then
    log "dry-run: would generate $token_file"
    return 0
  fi
  mkdir -p "$(dirname "$token_file")"
  if [ -r /dev/urandom ]; then
    token=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
  else
    token=$( (date '+%s'; cat /proc/sys/kernel/random/uuid 2>/dev/null) | cksum | tr -d ' ' )
    log "WARNING: /dev/urandom unavailable; token entropy is weak"
  fi
  # umask before the redirect so the file is never briefly world-readable.
  (umask 077; printf '%s\n' "$token" >"$token_file") || die "cannot write $token_file"
  log "generated guard token at $token_file (0600)"
}

cmd_token() {
  token_file=$(token_path)
  [ -f "$token_file" ] || die "no token yet — start the supervisor first"
  cat "$token_file"
}

# The URL to open, token included. This is what the APK asks for over `su` so
# the token never has to be readable by the app's uid — every file above is
# 0600 root, and the app has no business reading the harness's signing key.
cmd_url() {
  guard_token_file=$(token_path)
  launch_file=$(harness_token_path)
  case "${1:-}" in
    --harness)
      [ -s "$launch_file" ] || die "no harness launch token yet — start the supervisor first"
      printf 'http://127.0.0.1:%s/?token=%s\n' "$DSH_HARNESS_PORT" "$(cat "$launch_file")"
      ;;
    '')
      if [ -s "$guard_token_file" ]; then
        printf 'http://127.0.0.1:%s/?token=%s\n' "$DSH_GUARD_PORT" "$(cat "$guard_token_file")"
      elif [ -s "$launch_file" ]; then
        printf 'http://127.0.0.1:%s/?token=%s\n' "$DSH_HARNESS_PORT" "$(cat "$launch_file")"
      else
        die "no token yet — start the supervisor first"
      fi
      ;;
    *) die "unknown argument '$1' to url (try --harness)" ;;
  esac
}

# The harness authenticates its own UI (measured on @deepseek-ai/dsh 0.2.0-rc.2):
# it prints `dsh web: http://127.0.0.1:<port>/?token=<43-char base64url>` and
# answers 401 to everything else until that token mints a signed cookie. The
# guard has to replay that exchange, so dshd has to capture the token — the log
# line is the only place the process publishes it.
#
# This is a version-pinned contract, which is why it fails closed and loudly
# rather than degrading: a guard that authenticates clients while the harness
# behind it answers 401 is the worst available shape, because everything looks
# healthy and the UI is unreachable. tools/install-harness.sh asserts the same
# contract at install time, so a version bump that changes it is caught before
# anyone depends on it.
#
# $1 is the log size at the moment this harness was spawned: only a line written
# *after* that belongs to the process that is running now. The log is appended to
# across restarts, and the harness mints a fresh token every time it starts, so
# without the offset a restart captures the previous run's token — instantly,
# because it is already on disk — and starts a guard holding a token the new
# harness has never heard of. The result is a device that looks healthy and
# answers every login with "502 … upstream bootstrap answered 401 … the harness
# launch-token contract changed", which is what one did, twice, and what the
# supervisor's own restart path did on every crash.
capture_launch_token() {
  log_file=$DSH_LOG/harness.log
  from=${1:-0}
  case "$from" in
    '' | *[!0-9]*) from=0 ;;
  esac
  waited=0
  while [ "$waited" -lt "$DSH_LAUNCH_TIMEOUT" ]; do
    if [ -f "$log_file" ]; then
      line=$(tail -c "+$((from + 1))" "$log_file" 2>/dev/null |
        sed -n 's|.*http://127\.0\.0\.1:[0-9][0-9]*/?token=\([A-Za-z0-9_-][A-Za-z0-9_-]*\).*|\1|p' |
        tail -n 1)
      if [ -n "$line" ]; then
        (umask 077; printf '%s\n' "$line" >"$(harness_token_path)") || die "cannot write $(harness_token_path)"
        printf '%s\n' "$line"
        return 0
      fi
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

# ---------------------------------------------------------------------------
# Root solution: Magisk, KernelSU, KernelSU-Next
# ---------------------------------------------------------------------------
#
# dshd does not care which one granted root — it needs uid 0, a working su to
# point the APK at, and a su context that is allowed to mount and to run
# iptables. What differs between the three is exactly those things, so this
# reports them instead of assuming Magisk:
#
#   * KernelSU and KernelSU-Next share /data/adb/ksu and /data/adb/ksud (their
#     ksud/src/defs.rs agree on WORKING_DIR and DAEMON_PATH; only the backup file
#     prefix differs), so they are one code path with two version strings.
#   * Magisk keeps /data/adb/magisk and a su at /debug_ramdisk/su on 24+.
#   * Both can be installed at once: KernelSU hooks the kernel, Magisk the
#     ramdisk. The FAQ says KernelSU's su coexists with Magisk, so "both" is a
#     state to report, not an error.
#
# DSH_ADB is overridable so the host tests can point this at a fake tree.

: "${DSH_ADB:=/data/adb}"

ROOT_MAGISK_DIR="$DSH_ADB/magisk"
ROOT_KSU_DIR="$DSH_ADB/ksu"
ROOT_KSUD="$DSH_ADB/ksud"

# Su binaries, in the order that has actually worked across the three solutions.
# PATH first: when dshd runs from a root shell, that is the shell the operator
# was granted, and it is the one whose mount namespace this process inherits.
su_candidates() {
  s=$(command -v su 2>/dev/null) && [ -n "$s" ] && printf '%s\n' "$s"
  printf '%s\n' "$ROOT_KSU_DIR/bin/su"   # KernelSU, KernelSU-Next
  printf '%s\n' "/debug_ramdisk/su"      # Magisk 24+
  printf '%s\n' "/sbin/su"               # older Magisk
  printf '%s\n' "/system/bin/su"         # traditional, and some KernelSU setups
}

su_binary() {
  for c in $(su_candidates); do
    [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

magisk_version() {
  m="$ROOT_MAGISK_DIR/magisk"
  if [ ! -x "$m" ]; then
    m=$(command -v magisk 2>/dev/null) || return 1
  fi
  [ -n "${m:-}" ] && [ -x "$m" ] || return 1
  "$m" -v 2>/dev/null | head -n 1
}

ksu_version() {
  k=""
  [ -x "$ROOT_KSUD" ] && k="$ROOT_KSUD"
  [ -z "$k" ] && k=$(command -v ksud 2>/dev/null)
  [ -n "${k:-}" ] || return 1
  out=$("$k" --version 2>/dev/null) || out=$("$k" -V 2>/dev/null)
  [ -n "$out" ] || return 1
  printf '%s\n' "$out" | head -n 1
}

# KernelSU or KernelSU-Next? The version string is the cheap signal; when it is
# uninformative, the two managers are separate packages, which is authoritative.
ksu_variant() {
  case "$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')" in
    *next* | *ksun*) printf 'kernelsu-next\n'; return 0 ;;
  esac
  if command_exists pm && pm list packages 2>/dev/null | grep -q 'com.rifsxd.ksunext'; then
    printf 'kernelsu-next\n'
    return 0
  fi
  printf 'kernelsu\n'
}

# What is installed, in one word: magisk | kernelsu | kernelsu-next | both |
# none | unknown. "both" is honest: it says the su that granted this shell is
# not identifiable from paths alone, and `dshd root` prints the detail.
root_solution() {
  have_ksu=0
  have_magisk=0
  if [ -x "$ROOT_KSUD" ] || [ -d "$ROOT_KSU_DIR" ] || command_exists ksud; then
    have_ksu=1
  fi
  if [ -d "$ROOT_MAGISK_DIR" ] || command_exists magisk; then
    have_magisk=1
  fi

  if [ "$have_ksu" = 1 ] && [ "$have_magisk" = 1 ]; then
    printf 'both\n'
  elif [ "$have_ksu" = 1 ]; then
    ksu_variant "$(ksu_version)"
  elif [ "$have_magisk" = 1 ]; then
    printf 'magisk\n'
  else
    printf 'none\n'
  fi
}

# The SELinux context this shell is actually running in, which is the thing that
# decides whether mount and iptables are permitted. Magisk uses u:r:magisk:s0,
# KernelSU u:r:su:s0 by default, and both let the user change it per app, so this
# is read rather than assumed.
selinux_context() {
  if [ -r /proc/self/attr/current ]; then
    tr -d '\000' </proc/self/attr/current
  else
    printf 'unknown\n'
  fi
}

root_summary() {
  solution=$(root_solution)
  version=""
  case "$solution" in
    magisk) version=$(magisk_version) ;;
    kernelsu | kernelsu-next) version=$(ksu_version) ;;
    both)
      mv_=$(magisk_version)
      kv_=$(ksu_version)
      version="magisk ${mv_:-?}, $(ksu_variant "$kv_") ${kv_:-?}"
      ;;
  esac
  printf '%s%s (%s)\n' "$solution" "${version:+ $version}" "$(selinux_context)"
}

cmd_root() {
  printf 'solution:    %s\n' "$(root_solution)"
  printf 'magisk:      %s\n' "$(magisk_version 2>/dev/null || printf 'not found')"
  ksuv=$(ksu_version 2>/dev/null) || ksuv=""
  printf 'kernelsu:    %s%s\n' "${ksuv:-not found}" \
    "$([ -n "$ksuv" ] && printf ' [%s]' "$(ksu_variant "$ksuv")")"
  printf 'selinux:     %s\n' "$(selinux_context)"
  selinux_state="unknown"
  command_exists getenforce && selinux_state=$(getenforce 2>/dev/null)
  printf 'getenforce:  %s\n' "$selinux_state"
  printf 'adb dir:     %s\n' "$DSH_ADB"
  for d in magisk ksu; do
    if [ -d "$DSH_ADB/$d" ]; then printf '  %s/          present\n' "$d"; else printf '  %s/          absent\n' "$d"; fi
  done
  printf 'su:          %s\n' "$(su_binary 2>/dev/null || printf 'NOT FOUND — the APK cannot fetch the token')"
  printf 'su search:   %s\n' "$(su_candidates | tr '\n' ' ')"
  # Whether the su a *new* session gets is ours matters for mounts: a bind mount
  # made here lives in this mount namespace, and only descendants inherit it.
  printf 'note:        mounts made by dshd are visible to its children; a separate\n'
  printf '             su session may be in a different mount namespace (see\n'
  printf '             docs/root-solutions.md and run tools/probe.sh).\n'
}

# ---------------------------------------------------------------------------
# Mounts (§5 Phase 1)
# ---------------------------------------------------------------------------

# /dev/pts is a separate filesystem type: binding /dev alone does not provide a
# working devpts unless the bind is recursive, and a missing devpts silently
# costs every PTY allocation (plan §3).
mount_dev_pts() {
  target="$DSH_ROOTFS/dev/pts"
  [ -d "$target" ] || run mkdir -p "$target"
  if is_mounted "$target"; then
    return 0
  fi
  log "mounting devpts at $target"
  run mount -t devpts devpts "$target" 2>/dev/null \
    || run mount -t devpts -o gid=5,mode=620 devpts "$target" \
    || log "WARNING: devpts mount failed — the PTY terminal will not work"
}

ensure_mounts() {
  [ "$DSHD_NO_CHROOT" = 1 ] && return 0
  for d in proc sys dev dev/pts tmp workspace state; do
    [ -d "$DSH_ROOTFS/$d" ] || run mkdir -p "$DSH_ROOTFS/$d"
  done

  if ! is_mounted "$DSH_ROOTFS/proc"; then
    log "mounting proc at $DSH_ROOTFS/proc"
    run mount -t proc proc "$DSH_ROOTFS/proc" || die "cannot mount /proc into the rootfs"
  fi

  if [ "$DSH_MOUNT_SYS" = 1 ] && ! is_mounted "$DSH_ROOTFS/sys"; then
    log "mounting sysfs at $DSH_ROOTFS/sys"
    run mount -t sysfs sysfs "$DSH_ROOTFS/sys" || log "WARNING: sysfs mount failed"
  fi

  if ! is_mounted "$DSH_ROOTFS/dev"; then
    log "mounting /dev (recursive bind) at $DSH_ROOTFS/dev"
    # rec/rbind so /dev/pts, /dev/shm, /dev/mqueue come along if present.
    run mount -o bind,rec /dev "$DSH_ROOTFS/dev" \
      || run mount --rbind /dev "$DSH_ROOTFS/dev" \
      || die "cannot bind /dev into the rootfs"
  fi
  mount_dev_pts

  if ! is_mounted "$DSH_ROOTFS/workspace"; then
    log "binding workspace at $DSH_ROOTFS/workspace"
    run mount -o bind "$DSH_WORKSPACE" "$DSH_ROOTFS/workspace" || die "cannot bind the workspace"
  fi
  if ! is_mounted "$DSH_ROOTFS/state"; then
    log "binding state at $DSH_ROOTFS/state"
    run mount -o bind "$DSH_STATE" "$DSH_ROOTFS/state" || die "cannot bind DSH_HOME"
  fi
}

umount_mounts() {
  [ "$DSHD_NO_CHROOT" = 1 ] && return 0
  # Reverse dependency order; every step is best-effort with a lazy fallback,
  # so a half-mounted rootfs can still be torn down.
  for d in state workspace dev/pts dev sys proc; do
    target="$DSH_ROOTFS/$d"
    is_mounted "$target" || continue
    log "unmounting $target"
    run umount "$target" 2>/dev/null || run umount -l "$target" 2>/dev/null \
      || log "WARNING: could not unmount $target"
  done
}

# ---------------------------------------------------------------------------
# Child processes
# ---------------------------------------------------------------------------

ROOTFS_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Run a command inside the rootfs, in the foreground: chroot normally, direct
# exec in the development escape hatch (where in-rootfs paths are prefixed with
# DSH_ROOTFS).
exec_in_rootfs() {
  bin=$1
  shift
  if [ "$DSHD_NO_CHROOT" = 1 ]; then
    # Dev mode: an in-rootfs path exists on this host only under $DSH_ROOTFS,
    # while a host path (a locally installed node, say) is already usable.
    target="$DSH_ROOTFS$bin"
    [ -x "$bin" ] && target="$bin"
    env -i PATH="$ROOTFS_PATH" HOME=/root TMPDIR=/tmp LANG=C.UTF-8 "$target" "$@"
  else
    chroot "$DSH_ROOTFS" /usr/bin/env -i \
      PATH="$ROOTFS_PATH" HOME=/root TMPDIR=/tmp LANG=C.UTF-8 "$bin" "$@"
  fi
}

# Start a command inside the rootfs in the background; sets $spawned_pid.
#
# The difference from exec_in_rootfs() is not cosmetic, and it is measured
# rather than assumed: backgrounding a shell *function* (`exec_in_rootfs ... &`)
# makes $! the wrapper subshell, and the real process is a grandchild that
# survives SIGTERM to $!. `dshd stop` would then report success while the harness
# kept running and holding its port. A backgrounded simple command is exec'd by
# the forked shell, so $! is the process itself. Do not fold the two together.
#
# The child's stdout/stderr go to its own log file, never to the caller's, so a
# caller that captures this function's output cannot be held open by the child.
spawn_in_rootfs() {
  log_file=$1
  shift
  spawned_pid=""
  if [ "$DSHD_NO_CHROOT" = 1 ]; then
    target="$DSH_ROOTFS$1"
    [ -x "$1" ] && target="$1"
    shift
    env -i PATH="$ROOTFS_PATH" HOME=/root TMPDIR=/tmp LANG=C.UTF-8 \
      "$target" "$@" >>"$log_file" 2>&1 &
  else
    bin=$1
    shift
    chroot "$DSH_ROOTFS" /usr/bin/env -i \
      PATH="$ROOTFS_PATH" HOME=/root TMPDIR=/tmp LANG=C.UTF-8 \
      "$bin" "$@" >>"$log_file" 2>&1 &
  fi
  spawned_pid=$!
}

node_bin() {
  if [ "$DSHD_NO_CHROOT" = 1 ]; then
    if [ -x "$DSH_ROOTFS$DSH_NODE" ]; then
      printf '%s\n' "$DSH_NODE"
    elif command_exists node; then
      command -v node
    else
      printf '%s\n' node
    fi
  else
    printf '%s\n' "$DSH_NODE"
  fi
}

# The harness: `dsh web --no-open --port <port>`, loopback only, DSH_HOME=/state.
start_harness() {
  mode=$(permission_mode)
  log "starting harness: dsh web --no-open --port $DSH_HARNESS_PORT (permission_mode=$mode)"
  if [ "$DSHD_DRY_RUN" = 1 ]; then
    log "dry-run: harness not started"
    return 0
  fi
  # 0<&- style detachment matters: the supervisor keeps its own log fds, and
  # the child must not hold the caller's terminal open.
  #
  # Where the log ends right now is this run's starting point: see
  # capture_launch_token(). Measured before the spawn, never after — the harness
  # prints its token within a second of starting, and a size taken afterwards
  # would cut off the very line it is needed for.
  harness_log_start=$(file_size "$DSH_LOG/harness.log")
  case "$harness_log_start" in
    '' | *[!0-9]*) harness_log_start=0 ;;
  esac
  spawn_in_rootfs "$DSH_LOG/harness.log" "$DSH_HARNESS_BIN" \
    web --no-open --port "$DSH_HARNESS_PORT"
  harness_pid=$spawned_pid
  printf '%s\n' "$harness_pid" >"$DSH_RUN/harness.pid"
  log "harness pid $harness_pid"
}

# The §7 guard: token auth + Host/Origin allowlist in front of the harness.
start_guard() {
  node=$(node_bin)
  token_file=$(in_rootfs_path "$(guard_token_path_in)")
  log "starting guard: $DSH_GUARD_SCRIPT on 127.0.0.1:$DSH_GUARD_PORT -> 127.0.0.1:$DSH_HARNESS_PORT"
  if [ "$DSHD_DRY_RUN" = 1 ]; then
    log "dry-run: guard not started"
    return 0
  fi
  if [ ! -f "$(host_path "$DSH_GUARD_SCRIPT")" ]; then
    die "guard script missing at $(host_path "$DSH_GUARD_SCRIPT") — run tools/rootfs-setup.sh"
  fi
  # Fail closed: without the harness's own token the guard cannot open a session
  # behind its login, so starting it would swap one broken front door for
  # another. See capture_launch_token().
  if ! launch_token=$(capture_launch_token "${harness_log_start:-0}"); then
    die "the harness printed no launch token within ${DSH_LAUNCH_TIMEOUT}s (looked for 'http://127.0.0.1:<port>/?token=...' in $DSH_LOG/harness.log) — refusing to start a guard that cannot authenticate to the harness. If the harness version changed this URL shape, that is the contract to fix; see tools/install-harness.sh."
  fi
  upstream_token_file=$(in_rootfs_path "$(harness_token_path_in)")
  spawn_in_rootfs "$DSH_LOG/guard.log" "$node" "$(in_rootfs_path "$DSH_GUARD_SCRIPT")" \
    --listen "127.0.0.1:$DSH_GUARD_PORT" \
    --upstream "127.0.0.1:$DSH_HARNESS_PORT" \
    --token-file "$token_file" \
    --upstream-token-file "$upstream_token_file"
  guard_pid=$spawned_pid
  printf '%s\n' "$guard_pid" >"$DSH_RUN/guard.pid"
  log "guard pid $guard_pid"
}

kill_child() {
  file=$1
  label=$2
  [ -f "$file" ] || return 0
  pid=$(read_pid_file "$file") || { run rm -f "$file"; return 0; }
  if ! pid_alive "$pid"; then
    run rm -f "$file"
    return 0
  fi
  log "stopping $label (pid $pid)"
  run kill -TERM "$pid" 2>/dev/null
  waited=0
  while pid_alive "$pid" && [ "$waited" -lt "$DSH_STOP_TIMEOUT" ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if pid_alive "$pid"; then
    log "$label did not exit in ${DSH_STOP_TIMEOUT}s — SIGKILL"
    run kill -KILL "$pid" 2>/dev/null
  fi
  # Reap it, or the supervisor accumulates a zombie per crash.
  reap "$pid"
  run rm -f "$file"
}

# Rotate $1 by renaming generations. Only safe between child restarts: a
# running child holds the old fd and would keep writing to the renamed file.
rotate_log() {
  file=$1
  [ -f "$file" ] || return 0
  size=$(file_size "$file")
  [ -n "$size" ] || return 0
  [ "$size" -ge "$DSH_LOG_MAX_BYTES" ] || return 0
  i=$DSH_LOG_KEEP
  while [ "$i" -gt 1 ]; do
    [ -f "$file.$((i - 1))" ] && run mv -f "$file.$((i - 1))" "$file.$i"
    i=$((i - 1))
  done
  log "rotating $file (${size} bytes)"
  run mv -f "$file" "$file.1"
  run : >"$file"
}

rotate_logs() {
  rotate_log "$DSH_LOG/harness.log"
  rotate_log "$DSH_LOG/guard.log"
}

# ---------------------------------------------------------------------------
# Supervisor
# ---------------------------------------------------------------------------

stop_requested() { [ -f "$DSH_RUN/stop" ]; }

supervise() {
  # Children are a pair: if either dies the other is torn down and the pair is
  # restarted, so a half-up system (guard up, harness dead) never persists.
  backoff=$DSH_BACKOFF_MIN
  # Own the log directory: `dshd supervise` is also reachable directly, and
  # start_harness/start_guard open log files before anything else creates them.
  ensure_dirs
  log "supervisor started (base=$DSH_BASE, no_chroot=$DSHD_NO_CHROOT, dry_run=$DSHD_DRY_RUN)"
  trap 'log "supervisor received SIGTERM"; : >"$DSH_RUN/stop"' TERM INT
  run rm -f "$DSH_RUN/stop"

  stopping=0
  while [ "$stopping" = 0 ]; do
    rotate_logs
    started_at=$(now_seconds)
    start_harness
    start_guard

    # Liveness poll. Polling beats waiting on two children in POSIX sh, where
    # `wait -n` is unavailable.
    while [ "$stopping" = 0 ]; do
      sleep "$DSH_POLL_INTERVAL"
      if stop_requested; then
        log "stop requested"
        stopping=1
        break
      fi
      dead=""
      hp=$(read_pid_file "$DSH_RUN/harness.pid" 2>/dev/null) || hp=""
      gp=$(read_pid_file "$DSH_RUN/guard.pid" 2>/dev/null) || gp=""
      pid_alive "$hp" || dead="harness"
      [ -n "$dead" ] || { pid_alive "$gp" || dead="guard"; }
      if [ -n "$dead" ]; then
        log "$dead exited"
        break
      fi
    done

    kill_child "$DSH_RUN/guard.pid" guard
    kill_child "$DSH_RUN/harness.pid" harness

    [ "$stopping" = 1 ] && break

    uptime=$(( $(now_seconds) - started_at ))
    if [ "$uptime" -ge "$DSH_BACKOFF_RESET" ]; then
      backoff=$DSH_BACKOFF_MIN
    fi
    log "restarting pair in ${backoff}s (uptime ${uptime}s)"
    sleep "$backoff"
    backoff=$((backoff * 2))
    [ "$backoff" -gt "$DSH_BACKOFF_MAX" ] && backoff=$DSH_BACKOFF_MAX
  done

  log "supervisor exiting"
  run rm -f "$DSH_RUN/supervisor.pid" "$DSH_RUN/stop"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

preflight() {
  require_root
  [ -d "$DSH_ROOTFS" ] || die "rootfs not found at $DSH_ROOTFS — run tools/rootfs-setup.sh"
  if [ "$DSHD_NO_CHROOT" = 1 ]; then
    return 0
  fi
  [ -x "$DSH_ROOTFS$DSH_HARNESS_BIN" ] || die "harness not installed at $DSH_ROOTFS$DSH_HARNESS_BIN — run tools/install-harness.sh"
  [ -x "$DSH_ROOTFS$DSH_NODE" ] || die "node not installed at $DSH_ROOTFS$DSH_NODE — run tools/rootfs-setup.sh"
}

apply_firewall_if_configured() {
  script="$DSH_BASE/tools/firewall.sh"
  case "$DSH_FIREWALL" in
    on) [ -f "$script" ] || die "DSH_FIREWALL=on but $script is missing" ;;
    auto) [ -f "$script" ] || return 0 ;;
    *) return 0 ;;
  esac
  # The script is a separate process, and every value it needs came from the
  # environment or from a sourced dshd.conf — neither of which exports anything.
  # Without this the script receives none of its inputs, which is how a §7
  # control gets installed against the wrong uid, or not at all, while the log
  # says it was applied. tests/dshd.test.sh holds this to account.
  export DSH_APP_UID DSH_HARNESS_PORT DSH_GUARD_PORT DSH_BASE DSH_ROOTFS DSH_STATE
  log "applying firewall rule (app uid: ${DSH_APP_UID:-unset})"
  if [ "$DSHD_DRY_RUN" = 1 ]; then
    run sh "$script" apply
    return 0
  fi
  # Keep the script's diagnosis. "not applied" with no reason is the least
  # useful line in the log, and the reason is usually the whole answer: no
  # iptables, or a kernel without the owner match.
  out=$(sh "$script" apply 2>&1)
  rc=$?
  if [ -n "$out" ]; then
    printf '%s\n' "$out" | while IFS= read -r line; do
      [ -n "$line" ] && log "firewall: $line"
    done
  fi
  [ "$rc" = 0 ] || log "WARNING: firewall rule not applied (exit $rc) — the §7 mitigation is incomplete"
  return 0
}

cmd_start() {
  preflight
  ensure_dirs

  sweep_stale_pid "$DSH_RUN/supervisor.pid" dshd supervisor
  if pid=$(read_pid_file "$DSH_RUN/supervisor.pid") && pid_is_ours "$pid" dshd; then
    log "already running (supervisor pid $pid)"
    cmd_status
    state_emit start
    return 0
  fi

  ensure_mounts
  ensure_token
  apply_firewall_if_configured

  if [ "$DSHD_DRY_RUN" = 1 ]; then
    log "dry-run: supervisor not spawned"
    state_emit start
    return 0
  fi

  rm -f "$DSH_RUN/stop"
  if command_exists setsid; then
    setsid "$DSHD_SELF" supervise >>"$DSH_LOG/dshd.log" 2>&1 &
  else
    nohup "$DSHD_SELF" supervise >>"$DSH_LOG/dshd.log" 2>&1 &
  fi
  supervisor_pid=$!
  printf '%s\n' "$supervisor_pid" >"$DSH_RUN/supervisor.pid"
  log "supervisor pid $supervisor_pid"

  log "waiting for readiness (up to ${DSH_START_TIMEOUT}s)"
  waited=0
  while [ "$waited" -lt "$DSH_START_TIMEOUT" ]; do
    if port_listening "$DSH_HARNESS_PORT" && port_listening "$DSH_GUARD_PORT"; then
      log "ready after ${waited}s"
      cmd_status
      state_emit start
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  log "ERROR: not ready after ${DSH_START_TIMEOUT}s — see $DSH_LOG/harness.log and $DSH_LOG/guard.log"
  return 4
}

cmd_stop() {
  require_root
  ensure_dirs
  : >"$DSH_RUN/stop"
  if pid=$(read_pid_file "$DSH_RUN/supervisor.pid") && pid_alive "$pid"; then
    log "signalling supervisor $pid"
    run kill -TERM "$pid" 2>/dev/null
    waited=0
    while pid_alive "$pid" && [ "$waited" -lt "$DSH_STOP_TIMEOUT" ]; do
      sleep 1
      waited=$((waited + 1))
    done
    pid_alive "$pid" && run kill -KILL "$pid" 2>/dev/null
  else
    log "no supervisor running"
  fi
  # Belt and braces: the supervisor tears its children down, but a supervisor
  # that was SIGKILLed cannot, so reap anything left holding a pid file.
  kill_child "$DSH_RUN/guard.pid" guard
  kill_child "$DSH_RUN/harness.pid" harness
  run rm -f "$DSH_RUN/supervisor.pid" "$DSH_RUN/stop"
  umount_mounts
  log "stopped"
  # "Stopped" is a state the app draws from, and without this block it had none:
  # a tap on STOP left the screen on "Not set up" with SET UP where START belongs.
  state_emit stop
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_status() {
  ensure_dirs
  rc=0
  sweep_stale_pid "$DSH_RUN/supervisor.pid" dshd supervisor
  sweep_stale_pid "$DSH_RUN/harness.pid" "" harness
  sweep_stale_pid "$DSH_RUN/guard.pid" "" guard

  if pid=$(read_pid_file "$DSH_RUN/supervisor.pid"); then
    printf 'supervisor:  running (pid %s)\n' "$pid"
  else
    printf 'supervisor:  stopped\n'
    rc=3
  fi

  for pair in "harness:$DSH_RUN/harness.pid:$DSH_HARNESS_PORT" "guard:$DSH_RUN/guard.pid:$DSH_GUARD_PORT"; do
    label=${pair%%:*}
    rest=${pair#*:}
    file=${rest%%:*}
    port=${rest##*:}
    if pid=$(read_pid_file "$file"); then
      state=running
    else
      state=stopped
      [ "$rc" = 0 ] && rc=3
    fi
    if port_listening "$port"; then
      listen="listening"
    elif [ "$?" = 2 ]; then
      listen="unknown"
    else
      listen="not listening"
      [ "$rc" = 0 ] && rc=3
    fi
    printf '%-11s %s (pid %s), port %s %s\n' "$label:" "$state" "${pid:-none}" "$port" "$listen"
  done

  printf 'permission:  %s\n' "$(permission_mode)"
  printf 'confinement: %s\n' "$(confinement_status)"
  printf 'root:        %s\n' "$(root_summary)"
  printf 'firewall:    %s (app uid: %s)\n' "$DSH_FIREWALL" "${DSH_APP_UID:-unset}"
  printf 'home:        %s (in-chroot %s)\n' "$DSH_STATE" "$DSH_STATE_IN"
  printf 'workspace:   %s (in-chroot %s)\n' "$DSH_WORKSPACE" "$DSH_WORKSPACE_IN"
  printf 'token:       %s\n' "$( [ -s "$(token_path)" ] && printf 'present' || printf 'absent')"

  if [ -r /proc/mounts ]; then
    printf 'mounts:     '
    for d in proc dev dev/pts workspace state; do
      if is_mounted "$DSH_ROOTFS/$d"; then
        printf ' %s' "$d"
      else
        printf ' [%s MISSING]' "$d"
      fi
    done
    printf '\n'
  fi

  if [ -x "$(host_path "$DSH_HARNESS_BIN")" ] || [ "$DSHD_NO_CHROOT" = 1 ]; then
    version=$(
      exec_in_rootfs "$DSH_HARNESS_BIN" --version 2>/dev/null | head -n 1
    ) || version=""
    [ -n "$version" ] && printf 'harness:     %s\n' "$version"
  fi
  return "$rc"
}

cmd_logs() {
  ensure_dirs
  follow=${1:-}
  if [ "$follow" = "-f" ]; then
    tail -n 40 -f "$DSH_LOG/dshd.log" "$DSH_LOG/harness.log" "$DSH_LOG/guard.log"
    return 0
  fi
  for f in dshd harness guard; do
    printf '=== %s.log (last 20) ===\n' "$f"
    tail -n 20 "$DSH_LOG/$f.log" 2>/dev/null || printf '(none)\n'
  done
}

cmd_doctor() {
  ensure_dirs
  printf 'dshd        %s\n' "$DSHD_VERSION"
  printf 'base        %s\n' "$DSH_BASE"
  printf 'rootfs      %s\n' "$DSH_ROOTFS"
  printf 'no_chroot   %s\n' "$DSHD_NO_CHROOT"
  printf 'dry_run     %s\n' "$DSHD_DRY_RUN"
  printf 'config      %s\n' "$CONF"
  cmd_status
  if [ -f "$DSH_BASE/tools/doctor.sh" ] && [ "${1:-}" != "--status-only" ]; then
    printf '\n--- tools/doctor.sh ---\n'
    sh "$DSH_BASE/tools/doctor.sh" || true
  fi
}

# ---------------------------------------------------------------------------
# setup — the one command the APK runs (Phase 5)
# ---------------------------------------------------------------------------
#
# The point of this verb is that the app never learns the phases. It streams the
# payload in, runs one root command, and renders what comes back:
#
#     su -c 'sh /data/local/dsh/bin/dshd setup --app-uid <uid>'
#
# Progress is a line protocol on stdout, deliberately mixed with the raw output
# of the tools, so a human running the same command in a terminal sees the run
# the app sees:
#
#     ##dshd <nonce> step <name> <message>
#     ##dshd <nonce> ok|skip|fail <name> [detail]
#     ##dshd <nonce> note <message>
#     ##dshd <nonce> url <url>
#     ##dshd <nonce> done ok|fail
#     ##dshd <nonce> info <key> <value>          (setup --check)
#
# <name> matches [a-z][a-z0-9_-]* so it can be a UI key with no quoting or
# escaping anywhere in the chain; <message> is the rest of the line and may be
# prose. The nonce identifies one run, so a stream mixed up with another run's
# is detectable rather than silently half-rendered. The payload bootstrap emits
# the same shape with the literal nonce `pre`, before any of this runs.
#
# A step's own exit status decides its report — including through `tee`, which is
# the trap that turns a failed download into a green tick. Steps already done
# report `skip`, not `ok`: "nothing to do" and "just did it" look identical in a
# log and mean different things to the person watching.
#
# Exit codes: 0 ok · 1 usage/config · 2 not root · 3 prerequisite failed ·
#             4 start timed out · 5 a setup step failed

SETUP_LOG=""
SETUP_NONCE=""
SETUP_APP_UID=""
SETUP_RECHECK=0
SETUP_ALLOW_UNENFORCED=0
SETUP_REPLACE_ROOTFS=0
SETUP_BOOT=skip

# Overridable because the tests are not on a device and because a module-style
# install may want its own directory; the default is the path all three root
# solutions run.
: "${DSH_BOOT_SERVICE_DIR:=/data/adb/service.d}"
BOOT_SCRIPT_DIR="$DSH_BOOT_SERVICE_DIR"
BOOT_SCRIPT="$BOOT_SCRIPT_DIR/dshd.sh"

setup_emit() {
  printf '##dshd %s %s\n' "$SETUP_NONCE" "$*"
}

setup_nonce() {
  printf '%s-%s\n' "$(date '+%s')" "$$"
}

# The payload's identity, as written by tools/mkpayload.sh. Deliberately not
# recomputed here: the build-time digest is what the app compares against its own
# asset, and hashing the tree at runtime would answer a different question.
setup_payload_digest() {
  [ -f "$DSH_BASE/payload.sha256" ] || return 0
  sed -n 's/^# payload-id:[[:space:]]*//p' "$DSH_BASE/payload.sha256" 2>/dev/null | head -n 1
}

# Run one step's command, journalling everything it prints, and return its real
# status. `cmd | tee` reports tee's status, so the status is written to a file by
# the command itself, inside the pipeline, where nothing can rename it.
setup_command() {
  setup_journal=$1
  shift
  if command_exists tee; then
    cmd_rc_file="$DSH_RUN/setup.rc"
    rm -f "$cmd_rc_file"
    { "$@" 2>&1; printf '%s\n' "$?" >"$cmd_rc_file"; } | tee -a "$setup_journal"
    cmd_rc=$(cat "$cmd_rc_file" 2>/dev/null)
    rm -f "$cmd_rc_file"
    # No status at all means the command's shell died before it could report:
    # fail closed rather than assume success.
    [ -n "$cmd_rc" ] || return 1
    return "$cmd_rc"
  fi
  # Without tee the app still sees everything live; the journal just misses it,
  # which is worth saying out loud rather than discovering later.
  setup_emit "note tee is not available; this run is not journalled to $setup_journal"
  "$@" 2>&1
}

# One step in the sequence: run it, and on failure close the protocol out with
# `done fail` before returning, so the app never has to infer the end of a run
# from the process's exit status alone.
setup_seq() {
  setup_step "$1" "$2" "$3"
  setup_seq_rc=$?
  if [ "$setup_seq_rc" != 0 ]; then
    # One exit code for "a step failed" (5), with the step's own status and name
    # in the protocol line above it: the app reads the fail event, while a script
    # that only looks at $? gets an answer that does not depend on which of the
    # steps happened to break. Not-root keeps 2, because that is the one failure
    # whose remedy is outside this app.
    [ "$setup_seq_rc" = 2 ] && return 2
    setup_emit "done fail"
    return 5
  fi
  return 0
}

# Announce, run, report. Returns 0 for success *and* for a deliberate skip
# (reported as `skip`, never as `ok`), otherwise the command's status.
setup_step() {
  setup_name=$1
  setup_msg=$2
  shift 2
  setup_emit "step $setup_name $setup_msg"
  SETUP_SKIP_REASON=""
  "$@"
  setup_step_rc=$?
  case "$setup_step_rc" in
    0) setup_emit "ok $setup_name"; return 0 ;;
    7) setup_emit "skip $setup_name ${SETUP_SKIP_REASON:-already done}"; return 0 ;;
    *) setup_emit "fail $setup_name exit $setup_step_rc"; return "$setup_step_rc" ;;
  esac
}

setup_step_probe() {
  [ -f "$DSH_BASE/tools/probe.sh" ] || {
    setup_emit "note tools/probe.sh is missing from the payload"
    return 3
  }
  setup_command "$SETUP_LOG" sh "$DSH_BASE/tools/probe.sh" --save "$DSH_LOG/p0.txt"
  step_rc=$?
  [ "$step_rc" = 0 ] || setup_emit "note the Phase 0 report is at $DSH_LOG/p0.txt"
  return "$step_rc"
}

setup_step_rootfs() {
  if [ "$SETUP_REPLACE_ROOTFS" != 1 ] &&
    [ -x "$DSH_ROOTFS/bin/sh" ] &&
    [ -x "$(host_path "$DSH_NODE")" ]; then
    SETUP_SKIP_REASON="the Linux base is already installed"
    return 7
  fi
  [ -f "$DSH_BASE/tools/rootfs-setup.sh" ] || {
    setup_emit "note tools/rootfs-setup.sh is missing from the payload"
    return 3
  }
  if [ "$SETUP_REPLACE_ROOTFS" = 1 ]; then
    setup_command "$SETUP_LOG" sh "$DSH_BASE/tools/rootfs-setup.sh" --force
  else
    setup_command "$SETUP_LOG" sh "$DSH_BASE/tools/rootfs-setup.sh"
  fi
  step_rc=$?
  [ "$step_rc" = 0 ] ||
    setup_emit "note if the base is present but incomplete, re-run with --replace-rootfs (it deletes $DSH_ROOTFS)"
  return "$step_rc"
}

# install-harness.sh is already idempotent against its own manifest, and it is
# the only thing that knows the pin, so setup passes it no version: a second copy
# of the pin here is a second thing to forget to bump.
setup_step_harness() {
  [ -f "$DSH_BASE/tools/install-harness.sh" ] || {
    setup_emit "note tools/install-harness.sh is missing from the payload"
    return 3
  }
  setup_command "$SETUP_LOG" sh "$DSH_BASE/tools/install-harness.sh"
}

setup_step_confinement() {
  if [ -f "$DSH_STATE/posture.conf" ] && [ "$SETUP_RECHECK" != 1 ]; then
    SETUP_SKIP_REASON="posture already recorded: $(confinement_status)"
    return 7
  fi
  [ -f "$DSH_BASE/tools/confinement-check.sh" ] || {
    setup_emit "note tools/confinement-check.sh is missing from the payload; refusing to record a posture that nothing proved"
    return 3
  }
  setup_command "$SETUP_LOG" sh "$DSH_BASE/tools/confinement-check.sh" --save "$DSH_STATE/posture.conf"
  step_rc=$?
  case "$step_rc" in
    0)
      setup_emit "note confinement: $(confinement_status)"
      return 0
      ;;
    5)
      # Not fatal, and not silent: the plan's answer to an unproven Landlock is
      # to pin the fallback and say so. The app repeats this on its status
      # screen, because someone who never opens a log still has to know.
      setup_emit "note confinement is NOT proven on this device: the agent runs with full access to the Linux base. Say so before trusting it with anything."
      return 0
      ;;
    *) return "$step_rc" ;;
  esac
}

setup_step_firewall() {
  [ -f "$DSH_BASE/tools/firewall.sh" ] || {
    setup_emit "note tools/firewall.sh is missing from the payload"
    return 3
  }
  DSH_APP_UID="$SETUP_APP_UID" \
    setup_command "$SETUP_LOG" sh "$DSH_BASE/tools/firewall.sh" apply --uid "$SETUP_APP_UID"
  step_rc=$?
  if [ "$step_rc" = 5 ] && [ "$SETUP_ALLOW_UNENFORCED" = 1 ]; then
    setup_emit "note the rule is NOT enforced and --allow-unenforced-firewall was given: every app on this device can open the guard port, and the token is then the only thing in front of the harness."
    return 0
  fi
  [ "$step_rc" = 5 ] &&
    setup_emit "note no rule was installed, so other apps can reach the guard port. Fix the cause above, or re-run with --allow-unenforced-firewall to accept that and carry on."
  return "$step_rc"
}

# The config is sourced by dshd as root, so every value written into it is a root
# command waiting to happen: values are quoted, and the numeric fields are
# validated before they get this far.
setup_shell_quote() {
  case "$1" in
    *"'"* | *'
'*) return 1 ;;
    *) printf "'%s'" "$1" ;;
  esac
}

setup_step_config() {
  setup_conf="$DSH_ETC/dshd.conf"
  setup_marker="# managed by dshd setup"
  if [ -f "$setup_conf" ] && ! grep -qF "$setup_marker" "$setup_conf" 2>/dev/null; then
    setup_emit "note $setup_conf was not written by setup — leaving it alone, and using --app-uid for this run only"
    return 0
  fi
  setup_base_q=$(setup_shell_quote "$DSH_BASE") || {
    setup_emit "note refusing to write a config with a quote in DSH_BASE"
    return 3
  }
  if [ "$SETUP_BOOT" = install ]; then
    setup_autostart=on
  else
    setup_autostart=off
  fi
  setup_content="$setup_marker
# Written by 'dshd setup', which is what the APK runs. dshd sources this file, so
# it is shell: keep values quoted or numeric. The marker line above is what stops
# the next setup run from overwriting your edits.
DSH_BASE=$setup_base_q
DSH_APP_UID=$SETUP_APP_UID
DSH_FIREWALL=on
DSH_HARNESS_PORT=$DSH_HARNESS_PORT
DSH_GUARD_PORT=$DSH_GUARD_PORT
autostart=$setup_autostart"
  if [ "$DSHD_DRY_RUN" = 1 ]; then
    log "dry-run: would write $setup_conf (app uid $SETUP_APP_UID, firewall on, autostart $setup_autostart)"
    return 0
  fi
  (umask 077; mkdir -p "$DSH_ETC" && printf '%s\n' "$setup_content" >"$setup_conf") || {
    setup_emit "note cannot write $setup_conf"
    return 3
  }
  return 0
}

setup_step_boot() {
  case "$SETUP_BOOT" in
    install) cmd_boot install ;;
    remove) cmd_boot remove ;;
    *)
      SETUP_SKIP_REASON="autostart was not requested"
      return 7
      ;;
  esac
}

setup_step_start() {
  cmd_start
}

cmd_setup() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-uid)
        shift
        SETUP_APP_UID=${1:-}
        ;;
      --recheck) SETUP_RECHECK=1 ;;
      --allow-unenforced-firewall) SETUP_ALLOW_UNENFORCED=1 ;;
      --replace-rootfs) SETUP_REPLACE_ROOTFS=1 ;;
      --boot)
        shift
        SETUP_BOOT=${1:-}
        ;;
      --check)
        shift
        cmd_setup_check "$@"
        return $?
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        log "ERROR: unknown argument '$1' to setup (try --help)" >&2
        return 1
        ;;
    esac
    shift
  done

  require_root

  # From here this run reports its own state block when it finishes, so the verbs
  # it calls on the way (start) stay quiet. See state_emit().
  SETUP_RUN=1

  # A numeric uid is not decoration: it lands in a config file that root sources
  # and in an iptables rule that decides who reaches the port. Anything else is
  # refused rather than escaped.
  case "$SETUP_APP_UID" in
    '')
      log "ERROR: setup needs --app-uid <uid> — it is the uid the firewall rule lets through. The APK passes its own (android.os.Process.myUid())." >&2
      return 1
      ;;
    *[!0-9]*)
      log "ERROR: --app-uid must be numeric, got '$SETUP_APP_UID'" >&2
      return 1
      ;;
  esac
  case "$DSH_HARNESS_PORT$DSH_GUARD_PORT" in
    *[!0-9]*)
      log "ERROR: ports must be numeric" >&2
      return 1
      ;;
  esac
  case "$SETUP_BOOT" in
    install | remove | skip) ;;
    *)
      log "ERROR: --boot takes install, remove or skip, got '$SETUP_BOOT'" >&2
      return 1
      ;;
  esac

  ensure_dirs
  SETUP_LOG="$DSH_LOG/setup.log"
  # mkdir directly rather than through run(): under DSHD_DRY_RUN the directory
  # would not exist, and a run whose journal silently does not exist is a run
  # nobody can diagnose afterwards. --check and the dry-run tests both come
  # through here.
  mkdir -p "$DSH_LOG" 2>/dev/null
  : >"$SETUP_LOG" 2>/dev/null || true
  SETUP_NONCE=$(setup_nonce)
  setup_emit "begin app_uid=$SETUP_APP_UID payload=$(setup_payload_digest) dshd=$DSHD_VERSION"
  log "setup: app uid $SETUP_APP_UID, journal $SETUP_LOG"

  setup_seq probe "checking what this device can do" setup_step_probe || return $?
  setup_seq rootfs "installing the Linux base (about 1 GB, first run only)" setup_step_rootfs || return $?
  setup_seq harness "installing the pinned DeepSeek Harness" setup_step_harness || return $?
  setup_seq confinement "checking the agent's sandbox" setup_step_confinement || return $?
  setup_seq firewall "keeping other apps off the ports" setup_step_firewall || return $?
  setup_seq config "saving settings" setup_step_config || return $?
  case "$SETUP_BOOT" in
    install | remove) setup_seq boot "installing boot autostart" setup_step_boot || return $? ;;
  esac
  setup_seq start "starting the server" setup_step_start || return $?

  setup_url_text=$(cmd_url 2>/dev/null | tail -n 1)
  if [ -n "$setup_url_text" ]; then
    setup_emit "url $setup_url_text"
  else
    setup_emit "note the running URL could not be read back; 'dshd url' will say why"
  fi
  # The same state block a check reports, so the app's screens are right the
  # moment a setup ends rather than at the next resume. See setup_state_lines().
  setup_state_lines
  setup_emit "done ok"
  return 0
}

# The state block the app keys every screen on: installed, harness, running,
# posture, payload, root, app_uid. Read from the device, never remembered.
#
# Both `setup` and `setup --check` emit it. A setup used to emit none of it, so
# the app had nothing to read when a setup *finished*: it drew "Not set up", with
# SET UP where START belongs and no STOP button, over a harness that was
# installed, running and already on screen in the WebView. One resume fixed it —
# onResume runs a check — which is why it survived: the wrong screen is what you
# get if you look at the app instead of leaving it and coming back.
setup_state_lines() {
  check_installed=no
  if [ -x "$DSH_ROOTFS/bin/sh" ] && [ -x "$(host_path "$DSH_NODE")" ]; then
    check_installed=yes
  fi
  check_harness=no
  [ -x "$(host_path "$DSH_HARNESS_BIN")" ] && check_harness=yes
  check_running=no
  if check_pid=$(read_pid_file "$DSH_RUN/supervisor.pid") && pid_is_ours "$check_pid" dshd; then
    check_running=yes
  fi

  setup_emit "info installed $check_installed"
  setup_emit "info harness $check_harness"
  setup_emit "info running $check_running"
  setup_emit "info posture $(confinement_status)"
  setup_emit "info payload $(setup_payload_digest)"
  setup_emit "info root $(root_solution)"
  check_uid=$(sed -n 's/^DSH_APP_UID=//p' "$DSH_ETC/dshd.conf" 2>/dev/null | head -n 1)
  setup_emit "info app_uid ${check_uid:-unset}"
}

# A verb that changed what is running reports the same state block a check does,
# so the app's screen is right when the verb ends rather than at the next resume.
#
# Silent inside a setup: that run has its own nonce, reports the block itself when
# it finishes, and saying it twice on one stream is noise. Two verbs in one run
# (`restart`) share the nonce of the first — a second nonce in one stream is two
# writers as far as the app is concerned — and both report, because the second
# one is the state the run ended in.
state_emit() {
  [ "${SETUP_RUN:-0}" = 1 ] && return 0
  [ -n "${SETUP_NONCE:-}" ] || SETUP_NONCE=$1
  setup_state_lines
}

# What the app asks before it decides which screen to show. Machine-readable on
# the same protocol, so the app has one parser and not two grammars.
cmd_setup_check() {
  require_root
  SETUP_NONCE=check

  setup_state_lines
  if [ "$check_running" = yes ]; then
    check_url=$(cmd_url 2>/dev/null | tail -n 1)
    [ -n "$check_url" ] && setup_emit "url $check_url"
  fi
  [ "$check_installed" = yes ] && return 0
  return 3
}

# ---------------------------------------------------------------------------
# boot — autostart through the root solution's own service directory
# ---------------------------------------------------------------------------

# Read without sourcing: this must not change dshd's environment.
boot_autostart() {
  boot_v=$(sed -n 's/^autostart=//p' "$DSH_ETC/dshd.conf" 2>/dev/null | tail -n 1)
  printf '%s\n' "${boot_v:-off}"
}

# Flip one key, keeping every other line — including comments a person added.
set_autostart() {
  want=$1
  conf="$DSH_ETC/dshd.conf"
  if [ "$DSHD_DRY_RUN" = 1 ]; then
    log "dry-run: would set autostart=$want in $conf"
    return 0
  fi
  (umask 077; mkdir -p "$DSH_ETC") || return 3
  if [ ! -f "$conf" ]; then
    (umask 077; printf 'autostart=%s\n' "$want" >"$conf") || return 3
    return 0
  fi
  tmp="$conf.tmp.$$"
  sed "s/^autostart=.*/autostart=$want/" "$conf" >"$tmp" || {
    rm -f "$tmp"
    return 3
  }
  grep -q '^autostart=' "$tmp" || printf 'autostart=%s\n' "$want" >>"$tmp"
  chmod 0600 "$tmp" 2>/dev/null
  mv "$tmp" "$conf" || {
    rm -f "$tmp"
    return 3
  }
  return 0
}

cmd_boot() {
  require_root
  boot_action=${1:-status}
  boot_src="$DSH_BASE/boot/service.d/dshd.sh"

  case "$boot_action" in
    install)
      [ -f "$boot_src" ] || {
        log "ERROR: $boot_src is missing from the payload" >&2
        return 3
      }
      [ -d "$BOOT_SCRIPT_DIR" ] || {
        log "ERROR: $BOOT_SCRIPT_DIR does not exist — there is no root-solution service directory to install into" >&2
        return 3
      }
      run cp "$boot_src" "$BOOT_SCRIPT" || return 4
      run chmod 0755 "$BOOT_SCRIPT" || return 4
      set_autostart on || return 4
      log "autostart installed at $BOOT_SCRIPT"
      return 0
      ;;
    remove)
      if [ -f "$BOOT_SCRIPT" ] && [ -f "$boot_src" ] && cmp -s "$boot_src" "$BOOT_SCRIPT"; then
        run rm -f "$BOOT_SCRIPT" || return 4
        log "removed $BOOT_SCRIPT"
      else
        log "$BOOT_SCRIPT is not the copy dshd installs — leaving it in place; autostart=off is what disables it"
      fi
      set_autostart off || return 4
      log "autostart off"
      return 0
      ;;
    status)
      if [ ! -f "$BOOT_SCRIPT" ]; then
        printf 'not installed %s\n' "$BOOT_SCRIPT"
      elif [ -f "$boot_src" ] && cmp -s "$boot_src" "$BOOT_SCRIPT"; then
        printf 'installed     %s (matches the payload)\n' "$BOOT_SCRIPT"
      else
        printf 'installed     %s (not the copy dshd installs, or stale)\n' "$BOOT_SCRIPT"
      fi
      printf 'autostart     %s\n' "$(boot_autostart)"
      return 0
      ;;
    *)
      log "ERROR: boot takes install, remove or status, got '$boot_action'" >&2
      return 1
      ;;
  esac
}

usage() {
  cat <<EOF
dshd $DSHD_VERSION — DeepSeek Harness supervisor for rooted Android

usage: dshd <command> [args]

  start              ensure mounts + token, spawn supervisor, wait for readiness
  stop               stop children, tear down mounts
  restart            stop then start
  setup [options]    the whole install in order and non-interactively, with a
                     ##dshd progress protocol on stdout. This is the one command
                     the APK runs, over su; nothing about it needs a terminal.
                       --app-uid N        the uid the firewall rule lets through
                                          (the APK passes its own)
                       --boot install|remove|skip   autostart via service.d
                       --recheck          re-run the Phase 3 posture check
                       --replace-rootfs   delete and re-fetch $DSH_ROOTFS
                       --allow-unenforced-firewall  carry on when no rule could
                                          be installed; says what stays exposed
  setup --check      machine-readable state on the same protocol, for the app;
                     exit 3 means "not set up yet"
  boot install|remove|status
                     autostart through /data/adb/service.d, and the autostart=
                     key in dshd.conf that gates it
  status             process, port, permission, confinement, root, mount summary
  root               which root solution granted this shell, and which su the
                     APK should use (Magisk, KernelSU, KernelSU-Next)
  token              print the guard token (§7); the APK fetches this via su
  url [--harness]    the URL to open, token included — the guard's front door by
                     default, or the harness port directly with --harness. This
                     is how the APK gets in without any token being readable by
                     the app's uid (everything is 0600 root).
  logs [-f]          last lines of dshd/harness/guard logs, or follow
  mounts             ensure the chroot bind mounts exist
  umount             tear down the chroot bind mounts
  rotate             rotate oversized logs (only safe while stopped)
  doctor             status plus tools/doctor.sh, if installed

Environment (or $CONF):
  DSH_BASE        $DSH_BASE
  DSH_BOOT_SERVICE_DIR $DSH_BOOT_SERVICE_DIR   (dshd boot install target)
  DSH_HARNESS_PORT $DSH_HARNESS_PORT   (loopback only, never exposed)
  DSH_GUARD_PORT  $DSH_GUARD_PORT   (the only port the app talks to)
  DSH_FIREWALL    $DSH_FIREWALL   auto|on|off
  DSH_APP_UID     ${DSH_APP_UID:-<unset>}
  DSHD_NO_CHROOT  $DSHD_NO_CHROOT   (1 = dev mode: no chroot, no mounts)
  DSHD_DRY_RUN    $DSHD_DRY_RUN   (1 = log instead of mutating)

Exit codes: 0 ok · 1 usage · 2 not root · 3 not running · 4 start timed out ·
             5 a setup step failed (the step's own status is in the fail event)
             The payload bootstrap runs before this and adds two of its own:
             6 the payload did not verify · 7 the install directory is not safe.
             Both name the check that refused, on the ##dshd protocol.
EOF
}

cmd_mounts() {
  require_root
  ensure_dirs
  ensure_mounts
  for d in proc dev dev/pts workspace state; do
    if is_mounted "$DSH_ROOTFS/$d"; then
      printf 'mounted     %s\n' "$d"
    else
      printf 'NOT mounted %s\n' "$d"
    fi
  done
}

main() {
  cmd=${1:-}
  [ $# -gt 0 ] && shift

  case "$cmd" in
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    setup) cmd_setup "$@" ;;
    boot) cmd_boot "$@" ;;
    status) cmd_status ;;
    root) cmd_root ;;
    token) cmd_token ;;
    url) cmd_url "${1:-}" ;;
    logs) cmd_logs "$@" ;;
    mounts) cmd_mounts ;;
    umount) require_root; umount_mounts ;;
    rotate) ensure_dirs; rotate_logs ;;
    doctor) cmd_doctor "$@" ;;
    supervise) supervise ;;
    version | --version) printf '%s\n' "$DSHD_VERSION" ;;
    help | --help | -h | "") usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
